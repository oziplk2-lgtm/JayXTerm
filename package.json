{
  "name": "jayxterm",
  "version": "0.10.19",
  "description": "A focused SSH and SFTP desktop client",
  "private": true,
  "author": "JayXTerm contributors",
  "main": "src/main.cjs",
  "productName": "JayXTerm",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "vite build --base=./ --outDir .codex-cache/build/renderer",
    "dev": "npm run build && electron .",
    "test": "node --test src/*.test.cjs",
    "build:drag": "node scripts/build-drag-out.cjs",
    "dist:win": "npm run build && npm run build:drag && electron-builder --win --x64",
    "build:finder-drag": "node scripts/build-finder-drag.cjs",
    "dist:mac": "npm run build && npm run build:finder-drag && electron-builder --mac dmg"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "iconv-lite": "^0.7.3",
    "ssh2": "^1.17.0",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "electron": "42.8.1",
    "electron-builder": "^26.0.0",
    "monaco-editor": "^0.57.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.jayxterm.app",
    "productName": "JayXTerm",
    "compression": "normal",
    "directories": {
      "output": ".codex-cache/releases"
    },
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "src/ssh-worker.cjs",
      "src/remote-text.cjs",
      "src/editor-windows.cjs",
      "src/editor-preload.cjs",
      "src/color-picker-preload.cjs",
      "src/session-duplicate.cjs",
      "src/store.cjs",
      "src/session-exchange.cjs",
      "src/app-settings.cjs",
      "src/command-history.cjs",
      "src/password-vault.cjs",
      "src/theme.mjs",
      "src/terminal-settings.mjs",
      "src/local-drag.cjs",
      "src/finder-drag.cjs",
      "src/transfers.cjs",
      ".codex-cache/build/renderer/**/*",
      "assets/jayxterm.png",
      "package.json",
      "LICENSE",
      "README.md",
      "!node_modules/cpu-features/**/*",
      "!node_modules/ssh2/lib/protocol/crypto/build/**/*",
      "src/codec.cjs",
      "src/windows.cjs"
    ],
    "mac": {
      "icon": "assets/jayxterm.png",
      "extraResources": [
        {
          "from": ".codex-cache/build/native/jayxterm-finder-drag.node",
          "to": "jayxterm-finder-drag.node"
        }
      ]
    },
    "win": {
      "icon": "assets/jayxterm.ico",
      "extraResources": [
        {
          "from": ".codex-cache/build/native/jayxterm-drag.exe",
          "to": "jayxterm-drag.exe"
        }
      ],
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "JayXTerm-${version}-${arch}-setup.${ext}"
    },
    "npmRebuild": false,
    "portable": {
      "artifactName": "JayXTerm-${version}-${arch}-portable.${ext}"
    },
    "electronDownload": {
      "cache": ".codex-cache/electron"
    }
  }
}
